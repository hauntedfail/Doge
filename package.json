{
  "name": "even-g2-x-reader",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @even-g2-x-reader/contracts && npm run build --workspace @even-g2-x-reader/gateway && npm run build --workspace @even-g2-x-reader/g2",
    "check": "npm run check --workspaces --if-present",
    "dev": "npm-run-all --parallel dev:gateway dev:g2",
    "dev:g2": "npm run dev --workspace @even-g2-x-reader/g2",
    "dev:gateway": "npm run dev --workspace @even-g2-x-reader/gateway",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "pack:g2": "npm run pack --workspace @even-g2-x-reader/g2",
    "pack:g2:production": "npm run pack:production --workspace @even-g2-x-reader/g2",
    "preview:live": "node scripts/start-live-preview.mjs",
    "production:key": "node scripts/copy-production-key.mjs",
    "production:start": "node scripts/start-doge-production.mjs",
    "relay:check": "node scripts/check-safe-relay.mjs",
    "relay:login": "node scripts/start-safe-relay.mjs",
    "relay:sync": "node scripts/sync-relay-catalog.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.6",
    "qr-image": "^3.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "twitter-api-safe-relay": "^0.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "twitter-api-safe-relay": {
      ".": "$twitter-api-safe-relay",
      "@hono/node-server": "2.1.0"
    },
    "esbuild": "0.28.2"
  }
}
