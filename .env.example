# Safe Relay stays loopback-only. Never expose this port through a tunnel.
TWITTER_RELAY_BASE_URL=http://127.0.0.1:6900
X_RELAY_CATALOG_PATH=./var/requests.ndjson

# mock: bundled deterministic data; relay: logged-in Safe Relay browser
X_SOURCE=mock
HOST=127.0.0.1
PORT=8787

# Optional now; required before exposing the gateway unless Cloudflare Access is used.
GATEWAY_BEARER_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
